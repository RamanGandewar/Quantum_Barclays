# Mode: demo (default) or native
PQC_MODE=demo

# Native mode only — path to oqs-provider shared library
OQS_PROVIDER_PATH=/usr/local/lib/ossl-modules/oqsprovider.so

# Native mode only — enable CIRCL in Go services
CIRCL_ENABLED=false

# Verifier API
VERIFIER_PORT=8000
LOG_LEVEL=info

# Prometheus metrics
METRICS_PORT=9090

# Dashboard
VITE_API_BASE_URL=http://localhost:8000

# PQC TLS service ports
PQC_TLS_PORT_NATIVE=8443
PQC_TLS_PORT_HYBRID=8444
PQC_TLS_PORT_CLASSICAL=8445

# KEMTLS service port
KEMTLS_PORT=8446

# SSH service ports
SSH_PORT=2222
SSH_TELEMETRY_PORT=8447
